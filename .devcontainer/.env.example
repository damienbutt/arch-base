# Example Development Container Configuration
# Copy to .env and customize for your setup

# GPG Configuration for Automatic Commit Signing
AUTO_SETUP_GPG=true

# Method 1: Use specific GPG key ID (if GPG directory is mounted)
# Get your key ID with: gpg --list-secret-keys --keyid-format LONG
# GPG_KEY_ID=ABC123DEF456789

# Method 2: Import GPG key from file
# Export your key with: gpg --export-secret-keys YOUR_KEY_ID > private-key.asc
# GPG_KEY_FILE=./private-key.asc

# Git User Configuration
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="your.email@example.com"
