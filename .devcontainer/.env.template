# Development Container Environment Configuration
# Copy this file to .env and customize for your local setup

# GPG Configuration for Automatic Commit Signing
# =============================================

# Option 1: Specify GPG Key ID (if key is already in mounted ~/.gnupg)
# Find your key ID with: gpg --list-secret-keys --keyid-format LONG
# Example: GPG_KEY_ID=ABC123DEF456789
GPG_KEY_ID=

# Option 2: Specify GPG Key File to Import (alternative to mounting ~/.gnupg)
# Path to your exported private key file (relative to project root or absolute)
# Export key with: gpg --export-secret-keys YOUR_KEY_ID > private-key.asc
# Example: GPG_KEY_FILE=./secrets/private-key.asc
GPG_KEY_FILE=

# Git User Configuration (will be set globally in container)
# ========================================================
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="your.email@example.com"

# GPG Automation Control
# =====================
AUTO_SETUP_GPG=true

# Additional Docker Compose Variables
# ==================================
# Add any other environment variables your development setup needs
